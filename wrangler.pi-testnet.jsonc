{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridianprotocol-pi-testnet",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.ts",
  "workers_dev": true,
  "vars": {
    "PI_TESTNET_MODE": "true"
  },
  "routes": [
    {
      "pattern": "testnet.meridianprotocol.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pi", "/pi/*"]
  },
  "ratelimits": [
    {
      "name": "PI_AUTH_LIMITER",
      "namespace_id": "9411081732",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ]
}
