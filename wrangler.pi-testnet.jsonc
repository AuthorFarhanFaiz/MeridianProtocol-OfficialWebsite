{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridianprotocol-pi-testnet",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ratelimits": [
    {
      "name": "PI_AUTH_LIMITER",
      "namespace_id": "9411081732",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ]
}
